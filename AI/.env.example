# ==========================================
# Copy file này thành .env và điền giá trị thật
# cp .env.example .env
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_elearning_db

# --- Google AI ---
GOOGLE_API_KEY=your_google_api_key_here

# --- HuggingFace ---
HUGGING_FACE_API_KEY=hf_your_token_here

# --- Groq ---
GROQ_API_KEY=gsk_your_groq_key_here

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# --- Cerebras ---
CEREBRAS_API_KEY=csk-your_cerebras_key_here

# --- Colab (nếu dùng GPU Colab) ---
COLAB_API_URL=http://host.docker.internal:8000

# ==========================================
# CẤU HÌNH LOCAL LLM (OLLAMA trên máy local/RTX 4090)
# Nếu Ollama chạy trên máy host: dùng host.docker.internal
# Nếu Ollama chạy container riêng: dùng tên service (vd: ollama)
# ==========================================
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:14b
DEEPSEEK_MODEL=deepseek-r1:14b
